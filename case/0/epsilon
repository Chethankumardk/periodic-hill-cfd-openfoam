FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 0.00416;

boundaryField
{
    inlet
    {
        type cyclic;
    }
    outlet
    {
        type cyclic;
    }

    front
    {
        type cyclic;
    }

    back
    {
        type cyclic;
    }

    top
    {
        type        epsilonWallFunction;
        value       uniform 0.1;
    }

    hills
    {
        type epsilonWallFunction;
        value uniform 0.00416;
    }
}
