FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
dimensions [0 2 -1 0 0 0 0];

internalField uniform 0;

boundaryField
{
    inlet
    {
        type cyclic;
    }

    outlet
    {
        type cyclic;
    }

    front
    {
        type cyclic;
    }

    back
    {
        type cyclic;
    }

    top
    {
         type        nutkWallFunction;
         value       uniform 0;
    }

    hills
    {
        type nutkWallFunction;
        value uniform 0;
    }
}

